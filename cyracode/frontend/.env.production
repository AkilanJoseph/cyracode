# Production build settings (used by `vite build`)
# Absolute backend URL baked into the bundle (the App Service has no /api proxy).
VITE_API_BASE_URL=https://cyracode-api.azurewebsites.net
# Google OAuth web client id. Must have https://cyracode-frontend.azurewebsites.net
# added under "Authorized JavaScript origins" in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=1052815738416-5i78kc963p2fimgnkvadv05pmj2640p3.apps.googleusercontent.com