<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service (Windows plan) configuration for the Vite build.

  Vite copies everything in frontend/public/ to dist/, so this file ships with
  the build and is picked up by IIS automatically. It is the Windows App
  Service equivalent of deploy/nginx.conf and frontend/server.js: same two
  rules, expressed for IIS.

  Rule 1 - the SPA fallback must not swallow missing assets.
    The widely copied rewrite rule matches ".*" and only checks that the file
    does not exist. That is not enough on its own: a request for
    /assets/missing-abc.js is a file that does not exist, so the rule fires
    and returns index.html as text/html. The browser then fails on the .js
    request with "Unexpected token '<'" instead of a clean 404. The third
    condition below is the part people leave out: only rewrite paths that have
    no file extension.

  Rule 2 - caching.
    /assets/ holds content-hashed filenames, so it can be cached for a year.
    index.html names every one of those assets, so it must never be cached or
    browsers will pin to a deploy and miss every future release.

  If you are on a Linux App Service plan this file is ignored - see
  deploy/README.md.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!-- Rule 1: client-side routes fall back to the SPA entry document.
             Paths with a file extension are deliberately excluded so a missing
             asset returns 404 rather than HTML. -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- Skip anything that looks like a real file request. -->
            <add input="{REQUEST_URI}" pattern="\.[a-zA-Z0-9]{2,5}$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Rule 2: long cache for hashed output, none for the entry document. -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1 year" />
      <location path="assets" cacheControlMode="UseMaxAge" cacheControlMaxAge="1 year" />
      <location path="index.html" cacheControlMode="DisableCache" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Only rewrite requests for files that exist in the deployment. Keeps
         Azure from serving a stale index.html out of a warm instance. -->
    <deployment>
      <add name="retries" value="3" />
    </deployment>

  </system.webServer>
</configuration>
