# Microsoft SQL Server (Windows auth / local default instance):
#   mssql+pyodbc://localhost/CyraCode?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
# Microsoft SQL Server (SQL auth):
#   mssql+pyodbc://sa:YourStrong@Passw0rd@localhost:1433/CyraCode?driver=ODBC+Driver+17+for+SQL+Server
DATABASE_URL=mssql+pyodbc://localhost/CyraCode?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
SMS_GATEWAY_URL=https://sms-gateway.example.com
SMS_API_KEY=your-sms-api-key
LOGISTICS_DEMO_API_KEY=logistics-demo-key
PARTNER_RATE_LIMIT_PER_MINUTE=100
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FRONTEND_URL=http://localhost:5173
# Extra comma-separated CORS origins (added to FRONTEND_URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
