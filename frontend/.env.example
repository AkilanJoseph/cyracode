# Google OAuth (Gmail sign-in) — required for the "or continue with" button.
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Add this app's origin to "Authorized JavaScript origins" (e.g. http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Backend API the Vite dev proxy targets (relative /api is proxied to this)
VITE_BACKEND_URL=http://localhost:8000
# Backend API base URL baked into production builds (no /api proxy on App Service).
# Set VITE_API_BASE_URL=https://cyracode-api.azurewebsites.net for production.
VITE_API_BASE_URL=/api
# Frontend dev server host/port
VITE_HOST=127.0.0.1
VITE_PORT=5173
